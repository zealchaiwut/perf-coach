# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.

# Which environment this instance serves. Must be 'uat' or 'prd'.
# start_uat.sh requires 'uat'; start_prd.sh requires 'prd'.
ENVIRONMENT=uat

# Neon Postgres connection string for the chosen environment.
# Find it in the Neon console under your project's "Connection Details".
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Git SHA of the current deploy. Render sets this automatically via
# ${{RENDER_GIT_COMMIT}}; for local dev any short string works.
GIT_SHA=dev

# Strava OAuth — required for /api/strava/connect
STRAVA_CLIENT_ID=your_strava_client_id          # From https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=your_strava_client_secret  # From https://www.strava.com/settings/api
STRAVA_STATE_SECRET=change_me_random_secret     # Random string; signs CSRF state tokens
STRAVA_REDIRECT_URI=http://localhost:9001/api/strava/callback  # Defaults to this if unset

# Google OAuth — required for /api/google/connect
# 1. Go to https://console.cloud.google.com/apis/credentials and create an
#    OAuth 2.0 Client ID of type "Web application".
# 2. Add your redirect URI (e.g. http://localhost:9001/api/google/callback for
#    local dev, and your Render URL for production) under "Authorized redirect URIs".
# 3. Copy the Client ID and Client Secret shown on the credentials page.
GOOGLE_CLIENT_ID=your_google_client_id          # "Client ID" from the credentials page
GOOGLE_CLIENT_SECRET=your_google_client_secret  # "Client secret" from the credentials page
GOOGLE_STATE_SECRET=change_me_random_secret     # Random string; signs CSRF state tokens
GOOGLE_REDIRECT_URI=http://localhost:9001/api/google/callback  # Defaults to this if unset

# Stryd — required for credential storage and sync
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRYD_FERNET_KEY=your_fernet_key_here

# Session signing — required for all authenticated routes (issue #296)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Real value must be set in the Render dashboard under Environment → Env Vars.
SESSION_SECRET=change-me

# Admin gate — required to enable /admin (issues #292, #296)
# Set the var matching your ENVIRONMENT. If unset, /admin returns 403.
# UAT instance reads ADMIN_SECRET_UAT; PRD instance reads ADMIN_SECRET_PRD.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Real values must be set in the Render dashboard under Environment → Env Vars.
ADMIN_SECRET_UAT=change-me
# ADMIN_SECRET_PRD=change-me   # set in PRD environment only

# Google login toggle (issue #295, #296)
# Set to 'true' to enable Google OAuth login; 'false' (or unset) disables it.
# Change this via the Render dashboard → Environment → Env Vars (not a secret).
GOOGLE_LOGIN_ENABLED=false

# Optional admin gate tuning (defaults shown):
# ADMIN_COOKIE_MAX_AGE=14400   # admin session lifetime in seconds (4 hours)
# ADMIN_LOCKOUT_MAX=5          # wrong-secret attempts before lockout
# ADMIN_LOCKOUT_WINDOW=300     # lockout window in seconds (5 minutes)

# Compute worker (backend/worker_app.py, runs on zeal-server, port 9100) —
# shares this same DATABASE_URL / Neon instance with the webapp.
# Required: shared secret checked against the X-Worker-Secret header on
# every /internal/* endpoint. If unset, the worker returns 503 for those routes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SHARED_SECRET=change-me
# Port the worker listens on.
WORKER_PORT=9100
# Comma-separated HH:MM times (Asia/Bangkok) the worker runs a full sync sweep.
WORKER_SYNC_TIMES=06:00,18:00
# Enable the worker's weekly Banister parameter refit ('1' on, '0' off).
WORKER_BANISTER_ENABLED=1
# Pull-queue poll loop (Phase 1). '1' (default) = the worker claims queued
# job_queue rows via SELECT ... FOR UPDATE SKIP LOCKED; '0' = HTTP push only.
QUEUE_POLL_ENABLED=1
# Sleep (seconds) between polls when the queue is empty.
QUEUE_POLL_INTERVAL_SECONDS=5
# Lease length (seconds) per claimed job; heartbeat re-extends every 60s. A
# crashed/slept worker's jobs are reclaimed by requeue_stale once the lease lapses.
QUEUE_LEASE_SECONDS=600
# Precompute (Phase 2): warm the training-load snapshot on the worker so web
# requests never pay the 180-day EWMA recompute. All default on.
#   PRECOMPUTE_ON_WRITE_ENABLED  (web) offload the workout-write recompute to the
#                                worker in queue mode; '0' = recompute inline.
#   PRECOMPUTE_AFTER_SYNC_ENABLED (worker) enqueue a precompute after each sync.
#   LOAD_READ_FROM_SNAPSHOT      (web) current_load() reads the snapshot cache;
#                                '0' = always recompute inline (debug/rollback).
# PRECOMPUTE_ON_WRITE_ENABLED=1
# PRECOMPUTE_AFTER_SYNC_ENABLED=1
# LOAD_READ_FROM_SNAPSHOT=1
# Sync routing (Phase 3). '1' (default) runs light incremental syncs in-process
# on the web tier; '0' routes them to the worker too (full/stream-heavy syncs
# always go to the worker).
# WEB_INCREMENTAL_SYNC_ENABLED=1
# Garmin source scaffold (Phase 3) — off by default; not implemented yet.
# GARMIN_SYNC_ENABLED=0
# Webapp-side kill switch for its own (legacy) Banister refit scheduler.
# Set to '0' on Render once the worker owns the refit, to avoid double-running it.
BANISTER_REFIT_ENABLED=1

# Worker delegation — route heavy paths (full syncs, backfill) to the worker.
# WORKER_TRIGGER_MODE selects HOW:
#   queue (default) — webapp enqueues a job_queue row; the worker pulls it. Both
#                     machines connect OUTBOUND to Neon only, so the worker can
#                     sit behind home NAT. No WORKER_BASE_URL needed.
#   http            — webapp POSTs to the worker's /internal/* (legacy push);
#                     needs WORKER_BASE_URL + WORKER_SHARED_SECRET below.
# WORKER_TRIGGER_MODE=queue
#
# http mode only: the worker's base URL (issue #1297).
# WORKER_BASE_URL=http://zeal-server:9100

# Opt-in in-process fallback when the worker is unreachable.
# OFF by default: an unreachable worker returns 503 rather than silently running
# the heavy path inside the web dyno. Set to '1' only as a temporary safety net.
# ROUTE_FULL_SYNC_FALLBACK_TO_INPROCESS=0
# ROUTE_BACKFILL_FALLBACK_TO_INPROCESS=0

# Legacy POST /api/sync/strava endpoint (BackgroundTasks path).
# Disabled by default — use POST /api/strava/sync instead.
# Set to '1' only if you need the old path for backwards compatibility.
# LEGACY_SYNC_STRAVA_ENABLED=0

# LLM coaching (issue #1311) — off by default.
# Set LLM_COACH_ENABLED=true AND provide a provider API key to enable.
# When disabled (default), zero behavior changes anywhere in the app.
# See docs/llm-coaching.md for the full contract.
#
# Providers: z.ai GLM (preferred when GLM_API_KEY is set — flash models are
# effectively free and avoid Groq's tight free-tier 8k-TPM/200k-TPD budget),
# Cerebras (opt-in only: LLM_PROVIDER=cerebras), or Groq.
# Force one with LLM_PROVIDER=glm|cerebras|groq.
LLM_COACH_ENABLED=false
# LLM_PROVIDER=glm                       # Optional; default: glm if GLM_API_KEY set, else groq
# GLM_API_KEY=your_zai_key_here          # From https://z.ai
# GLM_MODEL_FAST=glm-4.7-flash           # Fast tier (default shown)
# GLM_MODEL_DEEP=glm-4.7-flash           # Deep tier (default shown)
# CEREBRAS_API_KEY=csk_your_key_here     # From https://cloud.cerebras.ai
# CEREBRAS_MODEL_FAST=gpt-oss-120b       # Fast tier (default shown)
# CEREBRAS_MODEL_DEEP=gpt-oss-120b       # Deep tier (default shown)
# GROQ_API_KEY=gsk_your_key_here         # From https://console.groq.com/keys
# GROQ_MODEL_FAST=llama-3.1-8b-instant   # Fast tier (default shown)
# GROQ_MODEL_DEEP=openai/gpt-oss-120b    # Deep tier (default shown)
