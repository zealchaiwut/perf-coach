# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.

# Which environment this instance serves. Must be 'uat' or 'prd'.
# start_uat.sh requires 'uat'; start_prd.sh requires 'prd'.
ENVIRONMENT=uat

# Neon Postgres connection string for the chosen environment.
# Find it in the Neon console under your project's "Connection Details".
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Git SHA of the current deploy. Render sets this automatically via
# ${{RENDER_GIT_COMMIT}}; for local dev any short string works.
GIT_SHA=dev

# Strava OAuth — required for /api/strava/connect
STRAVA_CLIENT_ID=your_strava_client_id          # From https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=your_strava_client_secret  # From https://www.strava.com/settings/api
STRAVA_STATE_SECRET=change_me_random_secret     # Random string; signs CSRF state tokens
STRAVA_REDIRECT_URI=http://localhost:9001/api/strava/callback  # Defaults to this if unset

# Stryd — required for credential storage and sync
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRYD_FERNET_KEY=your_fernet_key_here
